{
  "expo": {
    "name": "One Word",
    "slug": "oneword",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0A2E"
    },
    "description": "Learn a new language daily - free AI practice, no ads, no limits. 11 languages supported.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bikelime.app",
      "infoPlist": {
        "CFBundleDisplayName": "One Word - Learn Languages"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0A2E"
      },
      "package": "com.bikelime.app",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "daf7e953-1082-44a7-88c5-3e72c4cea9d5"
      }
    },
    "plugins": [
      "@sentry/react-native"
    ]
  }
}
